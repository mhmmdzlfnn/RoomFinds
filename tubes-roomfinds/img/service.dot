digraph G { rankdir=LR; nodesep=0.35; ranksep=0.55; 
node [shape=plain, fontname="Liberation Sans", fontsize=10];
edge [fontname="Liberation Sans", fontsize=9, labelfontsize=9];
"AuthService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF1FB"><FONT POINT-SIZE="9">&lt;&lt;service&gt;&gt;</FONT><BR/><B>AuthService</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- penggunaRepository: PenggunaRepository</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ registrasiPenyewa(dto: RegistrasiPenyewaDto): Penyewa</TD></TR><TR><TD ALIGN="LEFT">+ registrasiPemilik(dto: RegistrasiPemilikDto): Pemilik</TD></TR><TR><TD ALIGN="LEFT">+ login(email: String, password: String, session: HttpSession): Pengguna</TD></TR><TR><TD ALIGN="LEFT">+ logout(session: HttpSession): void</TD></TR><TR><TD ALIGN="LEFT">+ getPenggunaAktif(session: HttpSession): Pengguna</TD></TR></TABLE></TD></TR></TABLE>>];
"KosService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF1FB"><FONT POINT-SIZE="9">&lt;&lt;service&gt;&gt;</FONT><BR/><B>KosService</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- kosRepository: KosRepository</TD></TR><TR><TD ALIGN="LEFT">- paketSewaService: PaketSewaService</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ buatKos(pemilik: Pemilik, dto: KosDto): Kos</TD></TR><TR><TD ALIGN="LEFT">+ ubahKos(id: Long, dto: KosDto): Kos</TD></TR><TR><TD ALIGN="LEFT">+ hapusKos(id: Long): void</TD></TR><TR><TD ALIGN="LEFT">+ getKosMilik(pemilik: Pemilik): List&lt;Kos&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
"KamarService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF7EE"><FONT POINT-SIZE="9">&lt;&lt;service&gt;&gt;</FONT><BR/><B>KamarService</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- kamarRepository: KamarRepository</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ tambahKamar(kosId: Long, dto: KamarDto): Kamar</TD></TR><TR><TD ALIGN="LEFT">+ ubahKamar(id: Long, dto: KamarDto): Kamar</TD></TR><TR><TD ALIGN="LEFT">+ hapusKamar(id: Long): void</TD></TR><TR><TD ALIGN="LEFT">+ cariKamarKosong(filter: FilterKamar): List&lt;Kamar&gt;</TD></TR><TR><TD ALIGN="LEFT">+ tandaiTerisi(kamarId: Long): void</TD></TR><TR><TD ALIGN="LEFT">+ tandaiKosong(kamarId: Long): void</TD></TR></TABLE></TD></TR></TABLE>>];
"LaporanService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF1FB"><FONT POINT-SIZE="9">&lt;&lt;service&gt;&gt;</FONT><BR/><B>LaporanService</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- kosRepository: KosRepository</TD></TR><TR><TD ALIGN="LEFT">- tagihanRepository: TagihanRepository</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ buatLaporan(kosId: Long, periode: YearMonth): LaporanBulanan</TD></TR><TR><TD ALIGN="LEFT">+ getPendapatanEnamBulan(kosId: Long): Map&lt;YearMonth, Double&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
"AdminService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FDF3E6"><FONT POINT-SIZE="9">&lt;&lt;service&gt;&gt;</FONT><BR/><B>AdminService</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- kosRepository: KosRepository</TD></TR><TR><TD ALIGN="LEFT">- penggunaRepository: PenggunaRepository</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ getKosMenunggu(): List&lt;Kos&gt;</TD></TR><TR><TD ALIGN="LEFT">+ verifikasiKos(kosId: Long, admin: SuperAdmin, setuju: boolean, catatan: String): Kos</TD></TR><TR><TD ALIGN="LEFT">+ nonaktifkanKos(kosId: Long, admin: SuperAdmin, alasan: String): Kos</TD></TR><TR><TD ALIGN="LEFT">+ cariPengguna(kataKunci: String, peran: String): List&lt;Pengguna&gt;</TD></TR><TR><TD ALIGN="LEFT">+ ubahStatusAkun(id: Long, admin: SuperAdmin, aktif: boolean, alasan: String): Pengguna</TD></TR><TR><TD ALIGN="LEFT">+ buatStatistik(): StatistikPlatform</TD></TR></TABLE></TD></TR></TABLE>>];
"PaketSewaService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF7EE"><FONT POINT-SIZE="9">&lt;&lt;service&gt;&gt;</FONT><BR/><B>PaketSewaService</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- paketSewaRepository: PaketSewaRepository</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ buatPaketDefault(kos: Kos): void</TD></TR><TR><TD ALIGN="LEFT">+ ubahDiskon(paketId: Long, persen: double): PaketSewa</TD></TR><TR><TD ALIGN="LEFT">+ setAktif(paketId: Long, aktif: boolean): void</TD></TR></TABLE></TD></TR></TABLE>>];
"BookingService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF1FB"><FONT POINT-SIZE="9">&lt;&lt;service&gt;&gt;</FONT><BR/><B>BookingService</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- bookingRepository: BookingRepository</TD></TR><TR><TD ALIGN="LEFT">- kamarService: KamarService</TD></TR><TR><TD ALIGN="LEFT">- tagihanService: TagihanService</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ ajukan(penyewa: Penyewa, dto: BookingDto): Booking</TD></TR><TR><TD ALIGN="LEFT">+ konfirmasi(id: Long, pemilik: Pemilik): Booking</TD></TR><TR><TD ALIGN="LEFT">+ tolak(id: Long, alasan: String): Booking</TD></TR><TR><TD ALIGN="LEFT">+ batalkan(id: Long, penyewa: Penyewa): Booking</TD></TR><TR><TD ALIGN="LEFT">+ checkOut(id: Long): Booking</TD></TR></TABLE></TD></TR></TABLE>>];
