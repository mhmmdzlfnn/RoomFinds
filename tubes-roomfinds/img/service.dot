"PenundaanService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF7EE"><FONT POINT-SIZE="9">&lt;&lt;service&gt;&gt;</FONT><BR/><B>PenundaanService</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- penundaanRepository: PenundaanRepository</TD></TR><TR><TD ALIGN="LEFT">- tagihanService: TagihanService</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ ajukan(tagihanId: Long, tgl: LocalDate, alasan: String): PengajuanPenundaan</TD></TR><TR><TD ALIGN="LEFT">+ putuskan(id: Long, setuju: boolean, catatan: String): PengajuanPenundaan</TD></TR><TR><TD ALIGN="LEFT">+ getPengajuanKos(kosId: Long): List&lt;PengajuanPenundaan&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
