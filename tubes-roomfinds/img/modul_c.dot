digraph G { rankdir=BT; nodesep=0.35; ranksep=0.55; 
node [shape=plain, fontname="Liberation Sans", fontsize=10];
edge [fontname="Liberation Sans", fontsize=9, labelfontsize=9];
"SuperAdmin" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FDF3E6"><B>SuperAdmin</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- jabatan: String</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ verifikasiKos(k: Kos, disetujui: boolean, catatan: String): void</TD></TR><TR><TD ALIGN="LEFT">+ nonaktifkanKos(k: Kos, alasan: String): void</TD></TR><TR><TD ALIGN="LEFT">+ blokirAkun(p: Pengguna, alasan: String): void</TD></TR><TR><TD ALIGN="LEFT">+ aktifkanAkun(p: Pengguna): void</TD></TR><TR><TD ALIGN="LEFT">+ getPeran(): String</TD></TR></TABLE></TD></TR></TABLE>>];
"StatistikPlatform" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FDF3E6"><B>StatistikPlatform</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- daftarKos: List&lt;Kos&gt;</TD></TR><TR><TD ALIGN="LEFT">- jumlahPenggunaPerPeran: Map&lt;String, Integer&gt;</TD></TR><TR><TD ALIGN="LEFT">- dibuatPada: LocalDateTime</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ hitungKosPerStatus(): Map&lt;StatusVerifikasiKos, Long&gt;</TD></TR><TR><TD ALIGN="LEFT">+ hitungKamarKosong(): long</TD></TR><TR><TD ALIGN="LEFT">+ hitungHargaRataRata(): double</TD></TR><TR><TD ALIGN="LEFT">+ hitungTingkatHunian(): double</TD></TR><TR><TD ALIGN="LEFT">+ getJumlahKosMenunggu(): long</TD></TR></TABLE></TD></TR></TABLE>>];
"AturanDenda" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FDF3E6"><FONT POINT-SIZE="9">&lt;&lt;interface&gt;&gt;</FONT><BR/><B>AturanDenda</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ hitungDenda(nominal: double, hariTerlambat: int): double</TD></TR><TR><TD ALIGN="LEFT">+ getMasaTenggang(): int</TD></TR><TR><TD ALIGN="LEFT">+ getDeskripsi(): String</TD></TR></TABLE></TD></TR></TABLE>>];
"DendaHarian" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FDF3E6"><B>DendaHarian</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- nominalPerHari: double</TD></TR><TR><TD ALIGN="LEFT">- masaTenggang: int</TD></TR><TR><TD ALIGN="LEFT">- batasMaksimal: double</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ hitungDenda(nominal: double, hariTerlambat: int): double</TD></TR><TR><TD ALIGN="LEFT">+ getMasaTenggang(): int</TD></TR><TR><TD ALIGN="LEFT">+ getDeskripsi(): String</TD></TR></TABLE></TD></TR></TABLE>>];
"DendaFlat" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FDF3E6"><B>DendaFlat</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- nominal: double</TD></TR><TR><TD ALIGN="LEFT">- masaTenggang: int</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ hitungDenda(nominal: double, hariTerlambat: int): double</TD></TR><TR><TD ALIGN="LEFT">+ getMasaTenggang(): int</TD></TR><TR><TD ALIGN="LEFT">+ getDeskripsi(): String</TD></TR></TABLE></TD></TR></TABLE>>];
"TanpaDenda" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FDF3E6"><B>TanpaDenda</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ hitungDenda(nominal: double, hariTerlambat: int): double</TD></TR><TR><TD ALIGN="LEFT">+ getMasaTenggang(): int</TD></TR><TR><TD ALIGN="LEFT">+ getDeskripsi(): String</TD></TR></TABLE></TD></TR></TABLE>>];
"AturanDendaFactory" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FDF3E6"><B>AturanDendaFactory</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><U>+ buat(jenis: JenisDenda, nominal: double, tenggang: int, batas: double): AturanDenda</U></TD></TR></TABLE></TD></TR></TABLE>>];
"Pembayaran" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FDF3E6"><FONT POINT-SIZE="9">&lt;&lt;abstract&gt;&gt;</FONT><BR/><I>Pembayaran</I></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT">- tagihan: Tagihan</TD></TR><TR><TD ALIGN="LEFT">- jumlah: double</TD></TR><TR><TD ALIGN="LEFT">- tanggal: LocalDateTime</TD></TR><TR><TD ALIGN="LEFT"># status: StatusPembayaran</TD></TR><TR><TD ALIGN="LEFT">- catatanVerifikasi: String</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ verifikasi(diterima: boolean, catatan: String): void</TD></TR><TR><TD ALIGN="LEFT">+ isDiterima(): boolean</TD></TR><TR><TD ALIGN="LEFT"><I>+ proses(): void</I></TD></TR><TR><TD ALIGN="LEFT"><I>+ getMetode(): String</I></TD></TR></TABLE></TD></TR></TABLE>>];
"PembayaranTransfer" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FDF3E6"><B>PembayaranTransfer</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- bankAsal: String</TD></TR><TR><TD ALIGN="LEFT">- namaPengirim: String</TD></TR><TR><TD ALIGN="LEFT">- buktiTransferPath: String</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ proses(): void</TD></TR><TR><TD ALIGN="LEFT">+ getMetode(): String</TD></TR></TABLE></TD></TR></TABLE>>];
"PembayaranTunai" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FDF3E6"><B>PembayaranTunai</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- namaPenerima: String</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ proses(): void</TD></TR><TR><TD ALIGN="LEFT">+ getMetode(): String</TD></TR></TABLE></TD></TR></TABLE>>];
"Kos" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFFFFF"><B>Kos</B></TD></TR></TABLE>>];
"Pengguna" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="9">&lt;&lt;abstract&gt;&gt;</FONT><BR/><I>Pengguna</I></TD></TR></TABLE>>];
"Tagihan" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFFFFF"><B>Tagihan</B></TD></TR></TABLE>>];
"SuperAdmin" -> "Pengguna" [arrowhead=empty];
"PembayaranTransfer" -> "Pembayaran" [arrowhead=empty];
"PembayaranTunai" -> "Pembayaran" [arrowhead=empty];
"DendaHarian" -> "AturanDenda" [arrowhead=empty, style=dashed];
"DendaFlat" -> "AturanDenda" [arrowhead=empty, style=dashed];
"TanpaDenda" -> "AturanDenda" [arrowhead=empty, style=dashed];
"Kos" -> "AturanDendaFactory" [arrowhead=vee, style=dashed, label="memakai"];
"AturanDendaFactory" -> "AturanDenda" [arrowhead=vee, style=dashed, label="membuat"];
"Tagihan" -> "Pembayaran" [dir=back, arrowtail=odiamond, taillabel="1", headlabel="*"];
"Tagihan" -> "AturanDenda" [arrowhead=vee, style=dashed, label="memakai"];
"SuperAdmin" -> "Kos" [arrowhead=vee, taillabel="1", headlabel="*", label="memverifikasi"];
"SuperAdmin" -> "StatistikPlatform" [arrowhead=vee, style=dashed, label="melihat"];
"StatistikPlatform" -> "Kos" [arrowhead=vee, taillabel="1", headlabel="*", label="merekap"];
}