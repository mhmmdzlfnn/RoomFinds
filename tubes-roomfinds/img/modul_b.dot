digraph G { rankdir=BT; nodesep=0.35; ranksep=0.55; 
node [shape=plain, fontname="Liberation Sans", fontsize=10];
edge [fontname="Liberation Sans", fontsize=9, labelfontsize=9];
"Kamar" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF7EE"><FONT POINT-SIZE="9">&lt;&lt;abstract&gt;&gt;</FONT><BR/><I>Kamar</I></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT">- kos: Kos</TD></TR><TR><TD ALIGN="LEFT">- nomor: String</TD></TR><TR><TD ALIGN="LEFT"># hargaDasar: double</TD></TR><TR><TD ALIGN="LEFT">- luas: double</TD></TR><TR><TD ALIGN="LEFT">- fasilitas: List&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT">- status: StatusKamar</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ isTersedia(): boolean</TD></TR><TR><TD ALIGN="LEFT">+ ubahHarga(harga: double): void</TD></TR><TR><TD ALIGN="LEFT">+ ubahFasilitas(fasilitas: List&lt;String&gt;): void</TD></TR><TR><TD ALIGN="LEFT">+ tandaiDipesan(): void</TD></TR><TR><TD ALIGN="LEFT">+ tandaiTerisi(): void</TD></TR><TR><TD ALIGN="LEFT">+ tandaiKosong(): void</TD></TR><TR><TD ALIGN="LEFT"><I>+ hitungHargaBulanan(): double</I></TD></TR><TR><TD ALIGN="LEFT"><I>+ getTipe(): String</I></TD></TR></TABLE></TD></TR></TABLE>>];
"KamarStandar" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF7EE"><B>KamarStandar</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- kamarMandiDalam: boolean</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ hitungHargaBulanan(): double</TD></TR><TR><TD ALIGN="LEFT">+ getTipe(): String</TD></TR></TABLE></TD></TR></TABLE>>];
"KamarEksklusif" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF7EE"><B>KamarEksklusif</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- adaAC: boolean</TD></TR><TR><TD ALIGN="LEFT">- biayaFasilitasTambahan: double</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ hitungHargaBulanan(): double</TD></TR><TR><TD ALIGN="LEFT">+ getTipe(): String</TD></TR></TABLE></TD></TR></TABLE>>];
"PaketSewa" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF7EE"><FONT POINT-SIZE="9">&lt;&lt;abstract&gt;&gt;</FONT><BR/><I>PaketSewa</I></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT"># persenDiskon: double</TD></TR><TR><TD ALIGN="LEFT">- aktif: boolean</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ hitungTotalSewa(hargaBulanan: double): double</TD></TR><TR><TD ALIGN="LEFT">+ ubahDiskon(persen: double): void</TD></TR><TR><TD ALIGN="LEFT">+ setAktif(aktif: boolean): void</TD></TR><TR><TD ALIGN="LEFT"><I>+ getDurasiBulan(): int</I></TD></TR><TR><TD ALIGN="LEFT"><I>+ getNama(): String</I></TD></TR></TABLE></TD></TR></TABLE>>];
"SewaBulanan" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF7EE"><B>SewaBulanan</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ getDurasiBulan(): int</TD></TR><TR><TD ALIGN="LEFT">+ getNama(): String</TD></TR></TABLE></TD></TR></TABLE>>];
"SewaSemesteran" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF7EE"><B>SewaSemesteran</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ getDurasiBulan(): int</TD></TR><TR><TD ALIGN="LEFT">+ getNama(): String</TD></TR></TABLE></TD></TR></TABLE>>];
"SewaTahunan" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF7EE"><B>SewaTahunan</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ getDurasiBulan(): int</TD></TR><TR><TD ALIGN="LEFT">+ getNama(): String</TD></TR></TABLE></TD></TR></TABLE>>];
"Keluhan" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF7EE"><B>Keluhan</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT">- penyewa: Penyewa</TD></TR><TR><TD ALIGN="LEFT">- kamar: Kamar</TD></TR><TR><TD ALIGN="LEFT">- kategori: KategoriKeluhan</TD></TR><TR><TD ALIGN="LEFT">- deskripsi: String</TD></TR><TR><TD ALIGN="LEFT">- status: StatusKeluhan</TD></TR><TR><TD ALIGN="LEFT">- tanggapanPemilik: String</TD></TR><TR><TD ALIGN="LEFT">- dibuatPada: LocalDateTime</TD></TR><TR><TD ALIGN="LEFT">- diperbaruiPada: LocalDateTime</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ proses(tanggapan: String): void</TD></TR><TR><TD ALIGN="LEFT">+ selesaikan(tanggapan: String): void</TD></TR><TR><TD ALIGN="LEFT">+ bisaDihapus(): boolean</TD></TR><TR><TD ALIGN="LEFT">+ getUmurHari(): long</TD></TR></TABLE></TD></TR></TABLE>>];
"PengajuanPenundaan" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF7EE"><B>PengajuanPenundaan</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT">- tagihan: Tagihan</TD></TR><TR><TD ALIGN="LEFT">- tanggalDiminta: LocalDate</TD></TR><TR><TD ALIGN="LEFT">- alasan: String</TD></TR><TR><TD ALIGN="LEFT">- status: StatusPengajuan</TD></TR><TR><TD ALIGN="LEFT">- catatanPemilik: String</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ setujui(catatan: String): void</TD></TR><TR><TD ALIGN="LEFT">+ tolak(catatan: String): void</TD></TR><TR><TD ALIGN="LEFT">+ isDisetujui(): boolean</TD></TR></TABLE></TD></TR></TABLE>>];
"Booking" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFFFFF"><B>Booking</B></TD></TR></TABLE>>];
"Kos" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFFFFF"><B>Kos</B></TD></TR></TABLE>>];
"Penyewa" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFFFFF"><B>Penyewa</B></TD></TR></TABLE>>];
"Tagihan" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFFFFF"><B>Tagihan</B></TD></TR></TABLE>>];
"KamarStandar" -> "Kamar" [arrowhead=empty];
"KamarEksklusif" -> "Kamar" [arrowhead=empty];
"SewaBulanan" -> "PaketSewa" [arrowhead=empty];
"SewaSemesteran" -> "PaketSewa" [arrowhead=empty];
"SewaTahunan" -> "PaketSewa" [arrowhead=empty];
"Kos" -> "Kamar" [dir=back, arrowtail=diamond, taillabel="1", headlabel="1..*"];
"Kos" -> "PaketSewa" [dir=back, arrowtail=diamond, taillabel="1", headlabel="3"];
"Booking" -> "Kamar" [arrowhead=vee, taillabel="*", headlabel="1", label="memesan"];
"Booking" -> "PaketSewa" [arrowhead=vee, taillabel="*", headlabel="1"];
"Penyewa" -> "Keluhan" [arrowhead=vee, taillabel="1", headlabel="*", label="melaporkan"];
"Keluhan" -> "Kamar" [arrowhead=vee, taillabel="*", headlabel="1"];
"Tagihan" -> "PengajuanPenundaan" [dir=back, arrowtail=diamond, taillabel="1", headlabel="0..1"];
}