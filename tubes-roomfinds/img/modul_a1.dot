digraph G { rankdir=BT; nodesep=0.35; ranksep=0.55; 
node [shape=plain, fontname="Liberation Sans", fontsize=10];
edge [fontname="Liberation Sans", fontsize=9, labelfontsize=9];
"Pengguna" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF1FB"><FONT POINT-SIZE="9">&lt;&lt;abstract&gt;&gt;</FONT><BR/><I>Pengguna</I></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT">- nama: String</TD></TR><TR><TD ALIGN="LEFT">- email: String</TD></TR><TR><TD ALIGN="LEFT">- passwordHash: String</TD></TR><TR><TD ALIGN="LEFT">- noHp: String</TD></TR><TR><TD ALIGN="LEFT">- aktif: boolean</TD></TR><TR><TD ALIGN="LEFT">- alasanNonaktif: String</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ login(email: String, password: String): boolean</TD></TR><TR><TD ALIGN="LEFT">+ ubahProfil(nama: String, noHp: String): void</TD></TR><TR><TD ALIGN="LEFT">+ gantiPassword(lama: String, baru: String): void</TD></TR><TR><TD ALIGN="LEFT">+ nonaktifkan(alasan: String): void</TD></TR><TR><TD ALIGN="LEFT">+ aktifkan(): void</TD></TR><TR><TD ALIGN="LEFT"><I>+ getPeran(): String</I></TD></TR></TABLE></TD></TR></TABLE>>];
"Pemilik" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF1FB"><B>Pemilik</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- namaBank: String</TD></TR><TR><TD ALIGN="LEFT">- noRekening: String</TD></TR><TR><TD ALIGN="LEFT">- daftarKos: List&lt;Kos&gt;</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ tambahKos(kos: Kos): void</TD></TR><TR><TD ALIGN="LEFT">+ verifikasiPembayaran(p: Pembayaran, diterima: boolean, catatan: String): void</TD></TR><TR><TD ALIGN="LEFT">+ getPeran(): String</TD></TR></TABLE></TD></TR></TABLE>>];
"Penyewa" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF1FB"><B>Penyewa</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- asalKampus: String</TD></TR><TR><TD ALIGN="LEFT">- kontakDarurat: String</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ ajukanBooking(k: Kamar, p: PaketSewa, tglMasuk: LocalDate): Booking</TD></TR><TR><TD ALIGN="LEFT">+ laporkanKeluhan(kategori: KategoriKeluhan, deskripsi: String): Keluhan</TD></TR><TR><TD ALIGN="LEFT">+ getPeran(): String</TD></TR></TABLE></TD></TR></TABLE>>];
"Kos" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF1FB"><B>Kos</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT">- nama: String</TD></TR><TR><TD ALIGN="LEFT">- alamat: String</TD></TR><TR><TD ALIGN="LEFT">- kodePos: String</TD></TR><TR><TD ALIGN="LEFT">- statusVerifikasi: StatusVerifikasiKos</TD></TR><TR><TD ALIGN="LEFT">- catatanVerifikasi: String</TD></TR><TR><TD ALIGN="LEFT">- aturanKos: String</TD></TR><TR><TD ALIGN="LEFT">- tanggalJatuhTempo: int</TD></TR><TR><TD ALIGN="LEFT">- pemilik: Pemilik</TD></TR><TR><TD ALIGN="LEFT">- daftarKamar: List&lt;Kamar&gt;</TD></TR><TR><TD ALIGN="LEFT">- daftarPaket: List&lt;PaketSewa&gt;</TD></TR><TR><TD ALIGN="LEFT">- jenisDenda: JenisDenda</TD></TR><TR><TD ALIGN="LEFT">- nominalDenda: double</TD></TR><TR><TD ALIGN="LEFT">- masaTenggang: int</TD></TR><TR><TD ALIGN="LEFT">- batasDenda: double</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ ubahInfo(nama: String, aturanKos: String, tglJatuhTempo: int): void</TD></TR><TR><TD ALIGN="LEFT">+ ubahLokasi(alamat: String, kodePos: String): void</TD></TR><TR><TD ALIGN="LEFT">+ setujuiVerifikasi(): void</TD></TR><TR><TD ALIGN="LEFT">+ tolakVerifikasi(catatan: String): void</TD></TR><TR><TD ALIGN="LEFT">+ nonaktifkan(alasan: String): void</TD></TR><TR><TD ALIGN="LEFT">+ isTampilDiPencarian(): boolean</TD></TR><TR><TD ALIGN="LEFT">+ tambahKamar(k: Kamar): void</TD></TR><TR><TD ALIGN="LEFT">+ hapusKamar(idKamar: Long): void</TD></TR><TR><TD ALIGN="LEFT">+ cariKamarKosong(hargaMaks: double, tipe: String): List&lt;Kamar&gt;</TD></TR><TR><TD ALIGN="LEFT">+ hitungTingkatHunian(): double</TD></TR><TR><TD ALIGN="LEFT">+ setAturanDenda(jenis: JenisDenda, nominal: double, tenggang: int, batas: double): void</TD></TR><TR><TD ALIGN="LEFT">+ getAturanDenda(): AturanDenda</TD></TR></TABLE></TD></TR></TABLE>>];
"LaporanBulanan" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF1FB"><B>LaporanBulanan</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- kos: Kos</TD></TR><TR><TD ALIGN="LEFT">- periode: YearMonth</TD></TR><TR><TD ALIGN="LEFT">- daftarTagihan: List&lt;Tagihan&gt;</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ hitungPendapatan(): double</TD></TR><TR><TD ALIGN="LEFT">+ hitungTunggakan(): double</TD></TR><TR><TD ALIGN="LEFT">+ hitungTingkatHunian(): double</TD></TR><TR><TD ALIGN="LEFT">+ getPenyewaMenunggak(): List&lt;Penyewa&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
"Booking" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF1FB"><B>Booking</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT">- penyewa: Penyewa</TD></TR><TR><TD ALIGN="LEFT">- kamar: Kamar</TD></TR><TR><TD ALIGN="LEFT">- paket: PaketSewa</TD></TR><TR><TD ALIGN="LEFT">- tanggalMasuk: LocalDate</TD></TR><TR><TD ALIGN="LEFT">- tanggalSelesai: LocalDate</TD></TR><TR><TD ALIGN="LEFT">- status: StatusBooking</TD></TR><TR><TD ALIGN="LEFT">- setujuAturan: boolean</TD></TR><TR><TD ALIGN="LEFT">- waktuSetujuAturan: LocalDateTime</TD></TR><TR><TD ALIGN="LEFT">- alasanTolak: String</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ setujuiAturanKos(): void</TD></TR><TR><TD ALIGN="LEFT">+ konfirmasi(): void</TD></TR><TR><TD ALIGN="LEFT">+ tolak(alasan: String): void</TD></TR><TR><TD ALIGN="LEFT">+ batalkan(): void</TD></TR><TR><TD ALIGN="LEFT">+ checkOut(): void</TD></TR><TR><TD ALIGN="LEFT">+ hitungTotalSewa(): double</TD></TR><TR><TD ALIGN="LEFT">+ isAktif(): boolean</TD></TR></TABLE></TD></TR></TABLE>>];
"AturanDendaFactory" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFFFFF"><B>AturanDendaFactory</B></TD></TR></TABLE>>];
"Kamar" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="9">&lt;&lt;abstract&gt;&gt;</FONT><BR/><I>Kamar</I></TD></TR></TABLE>>];
"Keluhan" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFFFFF"><B>Keluhan</B></TD></TR></TABLE>>];
"PaketSewa" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="9">&lt;&lt;abstract&gt;&gt;</FONT><BR/><I>PaketSewa</I></TD></TR></TABLE>>];
"StatistikPlatform" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFFFFF"><B>StatistikPlatform</B></TD></TR></TABLE>>];
"SuperAdmin" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFFFFF"><B>SuperAdmin</B></TD></TR></TABLE>>];
"Tagihan" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFFFFF"><B>Tagihan</B></TD></TR></TABLE>>];
"Pemilik" -> "Pengguna" [arrowhead=empty];
"Penyewa" -> "Pengguna" [arrowhead=empty];
"SuperAdmin" -> "Pengguna" [arrowhead=empty];
"Pemilik" -> "Kos" [arrowhead=vee, taillabel="1", headlabel="1..*", label="mengelola"];
"Kos" -> "Kamar" [dir=back, arrowtail=diamond, taillabel="1", headlabel="1..*"];
"Kos" -> "PaketSewa" [dir=back, arrowtail=diamond, taillabel="1", headlabel="3"];
"Kos" -> "AturanDendaFactory" [arrowhead=vee, style=dashed, label="memakai"];
"Penyewa" -> "Booking" [arrowhead=vee, taillabel="1", headlabel="*", label="membuat"];
"Booking" -> "Kamar" [arrowhead=vee, taillabel="*", headlabel="1", label="memesan"];
"Booking" -> "PaketSewa" [arrowhead=vee, taillabel="*", headlabel="1"];
"Penyewa" -> "Keluhan" [arrowhead=vee, taillabel="1", headlabel="*", label="melaporkan"];
"Booking" -> "Tagihan" [arrowhead=vee, taillabel="1", headlabel="1..*", label="menghasilkan"];
"SuperAdmin" -> "Kos" [arrowhead=vee, taillabel="1", headlabel="*", label="memverifikasi"];
"StatistikPlatform" -> "Kos" [arrowhead=vee, taillabel="1", headlabel="*", label="merekap"];
"LaporanBulanan" -> "Kos" [arrowhead=vee, taillabel="*", headlabel="1"];
"LaporanBulanan" -> "Tagihan" [arrowhead=vee, taillabel="1", headlabel="*", label="merekap"];
}