digraph G { rankdir=BT; nodesep=0.35; ranksep=0.55; 
node [shape=plain, fontname="Liberation Sans", fontsize=10];
edge [fontname="Liberation Sans", fontsize=9, labelfontsize=9];
"DapatDitagih" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF1FB"><FONT POINT-SIZE="9">&lt;&lt;interface&gt;&gt;</FONT><BR/><B>DapatDitagih</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ hitungTotal(): double</TD></TR><TR><TD ALIGN="LEFT">+ getSisaTagihan(): double</TD></TR><TR><TD ALIGN="LEFT">+ isLunas(): boolean</TD></TR></TABLE></TD></TR></TABLE>>];
"Tagihan" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF1FB"><B>Tagihan</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT">- booking: Booking</TD></TR><TR><TD ALIGN="LEFT">- periode: YearMonth</TD></TR><TR><TD ALIGN="LEFT">- jatuhTempo: LocalDate</TD></TR><TR><TD ALIGN="LEFT">- items: List&lt;ItemTagihan&gt;</TD></TR><TR><TD ALIGN="LEFT">- daftarPembayaran: List&lt;Pembayaran&gt;</TD></TR><TR><TD ALIGN="LEFT">- penundaan: PengajuanPenundaan</TD></TR><TR><TD ALIGN="LEFT">- status: StatusTagihan</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ tambahItem(item: ItemTagihan): void</TD></TR><TR><TD ALIGN="LEFT">+ getJatuhTempoEfektif(): LocalDate</TD></TR><TR><TD ALIGN="LEFT">+ hitungDenda(hariIni: LocalDate): double</TD></TR><TR><TD ALIGN="LEFT">+ hitungTotal(): double</TD></TR><TR><TD ALIGN="LEFT">+ getSisaTagihan(): double</TD></TR><TR><TD ALIGN="LEFT">+ isLunas(): boolean</TD></TR><TR><TD ALIGN="LEFT">+ catatPembayaran(p: Pembayaran): void</TD></TR><TR><TD ALIGN="LEFT">+ bisaAjukanPenundaan(hariIni: LocalDate): boolean</TD></TR><TR><TD ALIGN="LEFT">+ ajukanPenundaan(tgl: LocalDate, alasan: String): PengajuanPenundaan</TD></TR><TR><TD ALIGN="LEFT">+ perbaruiStatus(hariIni: LocalDate): void</TD></TR></TABLE></TD></TR></TABLE>>];
"ItemTagihan" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF1FB"><FONT POINT-SIZE="9">&lt;&lt;abstract&gt;&gt;</FONT><BR/><I>ItemTagihan</I></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT"># keterangan: String</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><I>+ hitung(): double</I></TD></TR></TABLE></TD></TR></TABLE>>];
"BiayaSewa" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF1FB"><B>BiayaSewa</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- nominal: double</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ hitung(): double</TD></TR></TABLE></TD></TR></TABLE>>];
"BiayaTetap" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF1FB"><B>BiayaTetap</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- nominal: double</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ hitung(): double</TD></TR></TABLE></TD></TR></TABLE>>];
"BiayaPemakaian" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EAF1FB"><B>BiayaPemakaian</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">- meteranAwal: double</TD></TR><TR><TD ALIGN="LEFT">- meteranAkhir: double</TD></TR><TR><TD ALIGN="LEFT">- tarifPerUnit: double</TD></TR><TR><TD ALIGN="LEFT">- satuan: String</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ hitung(): double</TD></TR><TR><TD ALIGN="LEFT">+ getPemakaian(): double</TD></TR></TABLE></TD></TR></TABLE>>];
"AturanDenda" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="9">&lt;&lt;interface&gt;&gt;</FONT><BR/><B>AturanDenda</B></TD></TR></TABLE>>];
"Booking" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFFFFF"><B>Booking</B></TD></TR></TABLE>>];
"LaporanBulanan" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFFFFF"><B>LaporanBulanan</B></TD></TR></TABLE>>];
"Pembayaran" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="9">&lt;&lt;abstract&gt;&gt;</FONT><BR/><I>Pembayaran</I></TD></TR></TABLE>>];
"PengajuanPenundaan" [label=<<TABLE BORDER="1" STYLE="dashed" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFFFFF"><B>PengajuanPenundaan</B></TD></TR></TABLE>>];
"BiayaSewa" -> "ItemTagihan" [arrowhead=empty];
"BiayaTetap" -> "ItemTagihan" [arrowhead=empty];
"BiayaPemakaian" -> "ItemTagihan" [arrowhead=empty];
"Tagihan" -> "DapatDitagih" [arrowhead=empty, style=dashed];
"Booking" -> "Tagihan" [arrowhead=vee, taillabel="1", headlabel="1..*", label="menghasilkan"];
"Tagihan" -> "ItemTagihan" [dir=back, arrowtail=diamond, taillabel="1", headlabel="1..*"];
"Tagihan" -> "Pembayaran" [dir=back, arrowtail=odiamond, taillabel="1", headlabel="*"];
"Tagihan" -> "PengajuanPenundaan" [dir=back, arrowtail=diamond, taillabel="1", headlabel="0..1"];
"Tagihan" -> "AturanDenda" [arrowhead=vee, style=dashed, label="memakai"];
"LaporanBulanan" -> "Tagihan" [arrowhead=vee, taillabel="1", headlabel="*", label="merekap"];
}